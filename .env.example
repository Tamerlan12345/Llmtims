# --- Supabase Configuration ---
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Admin Session / Internal Auth ---
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_SESSION_TTL_HOURS=12
# Development only. Must stay false/unset in production.
ALLOW_MOCK_ADMIN_AUTH=false

# --- Database (PostgresSaver Persistence) ---
# Use the connection string from Supabase (Transaction Pooler is recommended)
DATABASE_URL=postgresql://postgres:[password]@db.[id].supabase.co:6543/postgres?sslmode=require

# --- AI Models (Gemini) ---
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# --- Telegram Integration ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret-token

# --- MCP & Environment ---
MCP_CONFIG_ENCRYPTION_KEY=replace-with-a-long-random-secret
GITHUB_TOKEN=your-github-token-for-mcp
E2B_API_KEY=your-e2b-api-key-if-using-managed-sandboxes
RAILWAY_API_KEY=your-railway-api-key
RAILWAY_PROJECT_ID=your-railway-project-id
RAILWAY_MANAGED_SERVICE_PREFIX=task-
